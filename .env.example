# HTTP port for the API (the built web app is served from here too)
PORT=8080

# TMDB credentials for posters, overviews, trailers and the Discover rows.
# Either a v3 API key or a v4 read access token works. https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_READ_TOKEN=

# Where favourites, watch progress and source configs are stored
DATA_DIR=./data

# If set, adding/editing/removing sources requires "Authorization: Bearer <token>"
ADMIN_TOKEN=

# Route streams through this server (fixes CORS and http-on-https mixed content).
# off: browser plays upstream URLs directly. fallback: direct first, proxy if the browser can't.
# on: always proxy. Proxying costs server bandwidth.
STREAM_PROXY=fallback
# Secret used to sign proxied stream URLs. Generated randomly at start if empty.
PROXY_SECRET=

# How often sources are re-fetched, in minutes
REFRESH_MINUTES=360

# Seed a demo source with openly licensed test streams (Blender films, test channels)
DEMO=1
